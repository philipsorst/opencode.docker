#!/bin/sh
set -eu

if [ -z "${HOME:-}" ]; then
    printf '%s\n' 'HOME must be set for the OpenCode auth mount.' >&2
    exit 1
fi

project_dir=$(pwd)
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
host_data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
host_opencode_dir="$host_data_home/opencode"
host_state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
host_opencode_state_dir="$host_state_home/opencode"
host_config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
host_opencode_config_dir="$host_config_home/opencode"
container_home=/home/opencode
container_opencode_config_dir="$container_home/.config/opencode"
container_opencode_dir="$container_home/.local/share/opencode"
container_opencode_state_dir="$container_home/.local/state/opencode"
image="${OPENCODE_DOCKER_IMAGE:-ddr-opencode}"
network="${OPENCODE_DOCKER_NETWORK:-development}"
opencode_command="${OPENCODE_DOCKER_COMMAND:-}"

tty_opts=-it
if [ "$opencode_command" = acp ]; then
    tty_opts=-i
fi

docker_bin="${DOCKER_BIN:-}"
if [ -z "$docker_bin" ]; then
    if [ -x /usr/bin/docker ]; then
        docker_bin=/usr/bin/docker
    elif [ -x /usr/local/bin/docker ]; then
        docker_bin=/usr/local/bin/docker
    else
        docker_bin=$(command -v docker || true)
    fi
fi

if [ -z "$docker_bin" ]; then
    printf '%s\n' 'Docker CLI not found. Set DOCKER_BIN to its absolute path.' >&2
    exit 127
fi

image_needs_rebuild=false
if "$docker_bin" image inspect "$image" >/dev/null 2>&1; then
    created=$("$docker_bin" image inspect --format '{{.Created}}' "$image" 2>/dev/null) || created=""
    if [ -n "$created" ]; then
        created_epoch=""
        if date -d "$created" +%s >/dev/null 2>&1; then
            created_epoch=$(date -d "$created" +%s)
        else
            created_norm=$(printf '%s' "$created" | sed 's/\.[0-9]*Z$/Z/; s/Z$//')
            if date -j -f '%Y-%m-%dT%H:%M:%S' "$created_norm" +%s >/dev/null 2>&1; then
                created_epoch=$(date -j -f '%Y-%m-%dT%H:%M:%S' "$created_norm" +%s)
            fi
        fi
        if [ -n "$created_epoch" ] && [ "$created_epoch" -lt "$(( $(date +%s) - 86400 ))" ]; then
            image_needs_rebuild=true
        fi
    fi
    # The image's opencode user must own /home/opencode as the same uid/gid
    # the launcher will run as, or the agent cannot write its home. Rebuild
    # when they differ; images that predate the label are left alone.
    image_uid=$("$docker_bin" image inspect --format '{{index .Config.Labels "org.opencode.docker.uid"}}' "$image" 2>/dev/null) || image_uid=
    image_gid=$("$docker_bin" image inspect --format '{{index .Config.Labels "org.opencode.docker.gid"}}' "$image" 2>/dev/null) || image_gid=
    if [ -n "$image_uid" ] && { [ "$image_uid" != "$(id -u)" ] || [ "$image_gid" != "$(id -g)" ]; }; then
        printf 'Image %s was built for UID/GID %s:%s but the current user is %s:%s; rebuilding.\n' \
            "$image" "$image_uid" "$image_gid" "$(id -u)" "$(id -g)" >&2
        image_needs_rebuild=true
    fi
else
    image_needs_rebuild=true
fi

if [ "$image_needs_rebuild" = true ]; then
    if [ ! -f "$script_dir/Dockerfile" ]; then
        printf 'Image %s not found and no Dockerfile at %s to build it.\n' "$image" "$script_dir/Dockerfile" >&2
        exit 1
    fi
    printf 'Image %s is missing, stale, or built for another user; rebuilding it from %s ...\n' "$image" "$script_dir/Dockerfile"
    "$docker_bin" build --pull -t "$image" \
        --build-arg "OPENCODE_UID=$(id -u)" \
        --build-arg "OPENCODE_GID=$(id -g)" \
        --build-arg "CACHEBUST=$(date +%s)" "$script_dir"
fi

if [ ! -d "$host_opencode_dir" ]; then
    printf 'OpenCode data directory not found: %s\n' "$host_opencode_dir" >&2
    exit 1
fi

if [ ! -f "$host_opencode_dir/auth.json" ]; then
    printf 'OpenCode auth file not found: %s/auth.json\n' "$host_opencode_dir" >&2
    printf '%s\n' 'Authenticate OpenCode on the host before using this launcher.' >&2
    exit 1
fi

uid=$(id -u)
gid=$(id -g)

mkdir -p "$host_opencode_state_dir"

author_name=""
author_email=""
if command -v git >/dev/null 2>&1; then
    author_name=$(git config user.name 2>/dev/null) || true
    author_email=$(git config user.email 2>/dev/null) || true
fi

git_identity_env=
if [ -n "$author_name" ] && [ -n "$author_email" ]; then
    printf 'Forwarding host git identity: %s <%s>\n' "$author_name" "$author_email"
    git_identity_env="
--env
GIT_AUTHOR_NAME=$author_name
--env
GIT_AUTHOR_EMAIL=$author_email
--env
GIT_COMMITTER_NAME=$author_name
--env
GIT_COMMITTER_EMAIL=$author_email"
fi

config_mounts=
if [ -f "$host_opencode_config_dir/opencode.docker.json" ]; then
    printf 'Mounting host OpenCode config (as opencode.json): %s/opencode.docker.json\n' "$host_opencode_config_dir" >&2
    config_mounts="$config_mounts
--mount
type=bind,src=$host_opencode_config_dir/opencode.docker.json,dst=$container_opencode_config_dir/opencode.json,ro"
fi

env_local_mounts=
if [ -f "$project_dir/.env.local" ]; then
    mask_file=$(mktemp)
    printf 'Masking %s/.env.local (mounted over with an empty read-only file).\n' "$project_dir" >&2
    env_local_mounts="$env_local_mounts
--mount
type=bind,src=$mask_file,dst=$project_dir/.env.local,ro"
fi

host_cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
container_cache_dir=$container_home/.cache
container_data_dir=$container_home/.local/share

cache_mounts=
mounted_dsts=
mounted_caches=

cache_mount() {
    cache_host_dir=$1
    mount_dst=$2
    mount_label=$3
    if [ -z "$cache_host_dir" ] || [ "$cache_host_dir" = / ]; then
        return 0
    fi
    case "$cache_host_dir" in
        "$project_dir"|"$project_dir"/*) return 0 ;;
    esac
    case " $mounted_dsts " in
        *" $mount_dst "*) return 0 ;;
    esac
    if [ ! -d "$cache_host_dir" ]; then
        mkdir -p "$cache_host_dir" 2>/dev/null || return 0
    fi
    cache_mounts="$cache_mounts
--mount
type=bind,src=$cache_host_dir,dst=$mount_dst"
    mounted_dsts="$mounted_dsts $mount_dst"
    mounted_caches="$mounted_caches $mount_label($cache_host_dir)"
}

add_tool_cache() {
    tool_label=$1
    tool_dst=$2
    tool_env=$3
    shift 3
    tool_host_dir=
    if [ -n "$tool_env" ]; then
        eval 'tool_host_dir=${'"$tool_env"':-}'
        case "$tool_host_dir" in
            /*) ;;
            *) tool_host_dir= ;;
        esac
    fi
    if [ -z "$tool_host_dir" ]; then
        for candidate in "$@"; do
            if [ -d "$candidate" ]; then
                tool_host_dir=$candidate
                break
            fi
        done
    fi
    cache_mount "$tool_host_dir" "$tool_dst" "$tool_label"
}

add_tool_cache uv "$container_cache_dir/uv" UV_CACHE_DIR "$host_cache_home/uv"
add_tool_cache pip "$container_cache_dir/pip" PIP_CACHE_DIR "$host_cache_home/pip"
add_tool_cache composer "$container_cache_dir/composer" COMPOSER_CACHE_DIR "$host_cache_home/composer"
add_tool_cache yarn "$container_cache_dir/yarn" YARN_CACHE_FOLDER "$host_cache_home/yarn"
add_tool_cache huggingface "$container_cache_dir/huggingface" HF_HOME "$host_cache_home/huggingface"
add_tool_cache npm "$container_home/.npm" NPM_CONFIG_CACHE "$HOME/.npm"
add_tool_cache gradle "$container_home/.gradle" GRADLE_USER_HOME "$HOME/.gradle"
add_tool_cache maven "$container_home/.m2" "" "$HOME/.m2"
add_tool_cache cargo "$container_home/.cargo" CARGO_HOME "$HOME/.cargo"
add_tool_cache go "$container_home/go/pkg/mod" GOMODCACHE "$HOME/go/pkg/mod"
add_tool_cache nuget "$container_home/.nuget/packages" NUGET_PACKAGES "$HOME/.nuget/packages"
add_tool_cache pub "$container_home/.pub-cache" PUB_CACHE "$HOME/.pub-cache"
add_tool_cache pnpm-store "$container_data_dir/pnpm/store" "" "$host_data_home/pnpm/store"
add_tool_cache pnpm-cache "$container_cache_dir/pnpm" "" "$host_cache_home/pnpm"

if [ -n "$mounted_caches" ]; then
    printf 'Mounting host caches:%s\n' "$mounted_caches"
fi

IFS='
'
exec "$docker_bin" run --rm --init $tty_opts \
    --network "$network" \
    --user "$uid:$gid" \
    --workdir "$project_dir" \
    --mount "type=bind,src=$project_dir,dst=$project_dir" \
    --mount "type=bind,src=$host_opencode_dir,dst=$container_opencode_dir" \
    --mount "type=bind,src=$host_opencode_state_dir,dst=$container_opencode_state_dir" \
    $config_mounts \
    $env_local_mounts \
    $cache_mounts \
    $git_identity_env \
    --env "HOME=$container_home" \
    --env "TERM=${TERM:-}" \
    --env "XDG_CONFIG_HOME=$container_home/.config" \
    --env "XDG_DATA_HOME=$container_home/.local/share" \
    --env "XDG_STATE_HOME=$container_home/.local/state" \
    --env "XDG_CACHE_HOME=$container_home/.cache" \
    --env OPENCODE_DISABLE_AUTOUPDATE=true \
    "$image" \
    $opencode_command "$@"
